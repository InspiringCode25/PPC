# Define the name of the shortcut to remove
$shortcutName = "Lock Screen.lnk"

# Define the path to the Public Desktop
$publicDesktopPath = "$env:PUBLIC\Desktop"

# Combine the full path to the shortcut
$shortcutPath = Join-Path -Path $publicDesktopPath -ChildPath $shortcutName

# Check if the shortcut exists
if (Test-Path $shortcutPath) {
    try {
        Remove-Item $shortcutPath -Force
        Write-Host "Shortcut '$shortcutName' has been removed from the Public Desktop."
    } catch {
        Write-Host "Failed to remove shortcut: $_"
    }
} else {
    Write-Host "Shortcut '$shortcutName' not found on the Public Desktop."
}

